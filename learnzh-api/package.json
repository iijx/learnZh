    "pino-pretty": "^13.0.0",
    "prisma": "^6.10.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.7",
    "bun": "^1.4.2",
    "vitest": "^1.0.0"
  }
