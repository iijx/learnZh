{
  "name": "learnzh-api",
  "version": "1.0.0",
  "description": "爸妈识字课小程序 进度/排期后端",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "pm2:start": "pm2 start ecosystem.config.js",
