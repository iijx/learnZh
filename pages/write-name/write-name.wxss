/* pages/write-name/write-name.wxss —— 写名字页 */
.page {
  padding: 24rpx 24rpx 60rpx;
}

.page-title {
  font-size: 56rpx;
  font-weight: bold;
  text-align: center;
  margin: 40rpx 0;
}

/* 名字输入框：字体 ≥48rpx */
.name-input {
  background: var(--color-bg-card);
  border: 4rpx solid var(--color-accent);
  border-radius: 24rpx;
  min-height: 140rpx;
  padding: 0 40rpx;
  font-size: 56rpx;
  color: var(--color-text);
  margin: 0 8rpx 48rpx;
}

.progress-text {
  font-size: 44rpx;
  text-align: center;
  margin: 16rpx 0 24rpx;
}

.char-wrap {
  display: flex;
  justify-content: center;
}

.trace-hint {
  text-align: center;
  margin: 24rpx 0 32rpx;
}

.praise-char {
  font-size: 160rpx;
  font-weight: bold;
  text-align: center;
  color: var(--color-accent);
  margin: 100rpx 0 32rpx;
}

.praise-sub {
  font-size: 48rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.btn-gap {
  height: 24rpx;
}

.change-name {
  text-align: center;
  margin-top: 60rpx;
  padding: 20rpx;
}
