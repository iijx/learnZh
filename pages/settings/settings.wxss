/* pages/settings/settings.wxss —— 设置页 */
.page {
  padding: 24rpx 24rpx 60rpx;
}

.page-title {
  font-size: 60rpx;
  font-weight: bold;
  text-align: center;
  margin: 20rpx 0 24rpx;
}

.setting-group {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  border: 4rpx solid var(--color-line);
  padding: 32rpx;
  margin: 20rpx 8rpx;
}

.setting-name {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

/* 一组大按钮单选 */
.option-row {
  display: flex;
  flex-wrap: wrap;
}

.option {
  flex: 1;
  min-width: 180rpx;
  min-height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  font-size: 42rpx;
  font-weight: bold;
  background: var(--color-bg);
  color: var(--color-text);
  border: 4rpx solid var(--color-line);
  border-radius: 24rpx;
  margin: 8rpx;
  padding: 0 16rpx;
}

.option:active {
  background: var(--color-line);
}

/* 当前选中项：墨绿高亮 */
.option-on {
  background: var(--color-accent);
  border-color: var(--color-accent-deep);
  color: #FFF8E7;
}

.volume-hint {
  margin-bottom: 20rpx;
}

.btn-gap {
  height: 24rpx;
}
