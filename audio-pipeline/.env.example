# 复制本文件为 .env（.env 已被 gitignore）。所有变量都可选——只覆盖 config.json 的对应字段，CI 用它注入凭证。
#
# 豆包 TTS（火山引擎语音技术控制台）
# 新版控制台填 API Key；旧版控制台填 AppID + AccessToken（填 apiKey 则忽略下面两个）
DOUBAO_API_KEY=
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
DOUBAO_VOICE=
DOUBAO_SPEECH_RATE=

# 腾讯云 COS（建议子账号最小权限密钥）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PREFIX=
COS_PUBLIC_BASE_URL=
