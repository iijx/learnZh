<!-- components/big-button/big-button.wxml —— 超大语音按钮
     适老化：高度 ≥160rpx、文字 ≥48rpx、点击区域大、点击即有语音提示 -->
<view
  class="bb ext-class {{type === 'plain' ? 'bb-plain' : 'bb-primary'}}"
  hover-class="bb-hover"
  bindtap="onTap"
>
  <view class="bb-text">{{text}}</view>
  <view wx:if="{{subText}}" class="bb-sub">{{subText}}</view>
</view>
