<!-- components/char-card/char-card.wxml —— 听音选字自适应卡片组
     适老化：支持 2/3/4 选 1；字 ≥160rpx；答错温柔微晃；连续错2次金光引导 -->
<view class="cc-grid cc-grid-{{options.length || 4}}">
  <view
    wx:for="{{options}}"
    wx:key="index"
    class="cc-card cc-card-{{options.length || 4}} {{item === answer && result === 'correct' ? 'cc-correct' : ''}} {{wrongChar === item ? 'cc-wrong' : ''}} {{item === answer && showHint ? 'cc-hint-glow' : ''}}"
    hover-class="cc-hover"
    data-index="{{index}}"
    bindtap="onCardTap"
  >
    <text class="cc-char">{{item}}</text>
    <view wx:if="{{item === answer && showHint}}" class="cc-hint-badge">点我</view>
  </view>
</view>

