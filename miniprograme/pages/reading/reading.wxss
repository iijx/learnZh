/* pages/reading/reading.wxss —— 阅读课（场景/古诗/故事 tab） */
.reading-page {
  min-height: 100vh;
  background-color: #FAF7F2;
  padding: 24rpx 36rpx 48rpx;
  box-sizing: border-box;
}

.btn-hover {
  opacity: 0.85;
}

/* 顶部 tab */
.tab-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.tab-item {
  flex: 1;
  height: 96rpx;
  border-radius: 16rpx;
  background-color: #FFFFFF;
  border: 3rpx solid #E6E0D6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #666666;
  box-sizing: border-box;
}

.tab-item.tab-active {
  background-color: #000000;
  border-color: #000000;
  color: #FFFFFF;
}

/* 列表项 */
.read-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #E6E0D6;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.read-item.read-locked {
  opacity: 0.55;
}

.read-main {
  flex: 1;
  min-width: 0;
}

.read-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #111111;
  line-height: 1.4;
}

.read-sub {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #999999;
}

.read-status {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #999999;
}

.read-status-open {
  color: #3E6B4F;
}

.empty-hint {
  margin-top: 80rpx;
  text-align: center;
  font-size: 34rpx;
  color: #999999;
}

/* 特大字号适配 */
.font-xl .tab-item {
  font-size: 46rpx;
}

.font-xl .read-title {
  font-size: 48rpx;
}
