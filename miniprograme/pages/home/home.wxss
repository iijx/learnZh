/* pages/home/home.wxss —— 首页布局（适老化：大目标、大字号、暖色） */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

/* 顶部：问候语 + 右上角设置入口（仍 ≥120rpx 高、≥40rpx 字） */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.greeting {
  font-size: 56rpx;
  font-weight: bold;
  color: var(--color-text);
}

.settings-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 170rpx;
  height: 110rpx;
  padding: 0 20rpx;
  font-size: 38rpx;
  font-weight: bold;
  color: var(--color-accent);
  background: var(--color-bg-card);
  border: 4rpx solid var(--color-accent);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(74, 52, 40, 0.06);
}

.gear-icon {
  margin-right: 8rpx;
  font-size: 40rpx;
}

.settings-entry-hover {
  opacity: 0.85;
}

/* 主按钮容器：约 1/3 屏高，按钮撑满（ext-class 穿透组件样式） */
.main-btn-wrap {
  min-height: 300rpx;
  margin-top: 36rpx;
  display: flex;
  align-items: stretch;
}
.main-btn-wrap big-button {
  flex: 1;
  display: flex;
}
.home-start-btn {
  width: 100% !important;
  height: 100%;
  margin: 0 !important;
  box-shadow: 0 10rpx 28rpx rgba(62, 107, 79, 0.25) !important;
}

/* 三个次级入口 */
.sub-entries {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

