/* pages/home/home.wxss —— 首页布局与视觉规范（适老化极简卡片） */

.home-container {
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #FAF7F2;
  padding: 24rpx 32rpx 48rpx 32rpx;
  display: flex;
  flex-direction: column;
}

/* 卡片通用容器 */
.card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
}

/* ===== 顶部主卡片：开始学习 ===== */
.learn-card {
  padding: 48rpx 44rpx 44rpx 44rpx;
}

.card-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #111111;
  line-height: 1.2;
  letter-spacing: 1rpx;
  margin-bottom: 40rpx;
  text-align: left;
}

/* 太阳徽章居中容器 */
.badge-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 44rpx;
}

.sun-badge {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background-color: #EAE6DF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sun-icon {
  width: 120rpx;
  height: 120rpx;
}

/* 问候与介绍正文 */
.welcome-section {
  font-size: 36rpx;
  line-height: 1.8;
  color: #222222;
  text-align: justify;
  word-break: break-all;
  margin-bottom: 48rpx;
  letter-spacing: 0.5rpx;
}

.lead-char {
  color: #B82A2A;
  font-size: 42rpx;
  font-weight: 900;
  margin-right: 4rpx;
  display: inline;
}

.lead-text {
  color: #222222;
  font-weight: 500;
}

/* 主操作按钮：进入今日课堂 */
.cta-btn {
  width: 100%;
  height: 114rpx;
  background-color: #000000;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.cta-btn-hover {
  opacity: 0.85;
  transform: scale(0.99);
}

.cta-btn-text {
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.cta-btn-arrow {
  color: #FFFFFF;
  font-size: 42rpx;
  font-weight: 700;
  margin-left: 14rpx;
  line-height: 1;
}

/* ===== 底部卡片：识字成果报告 ===== */
.report-card {
  margin-top: 28rpx;
  padding: 40rpx 44rpx 48rpx 44rpx;
  transition: opacity 0.15s ease;
}

.card-hover {
  opacity: 0.94;
}

.report-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.report-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.report-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #111111;
  margin-left: 18rpx;
  letter-spacing: 1rpx;
}

/* 数据两列布局 */
.report-metrics {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.metric-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.metric-label {
  font-size: 30rpx;
  color: #555555;
  font-weight: 500;
  margin-bottom: 14rpx;
}

.metric-val-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.metric-num {
  font-size: 80rpx;
  font-weight: 800;
  color: #000000;
  line-height: 1;
  font-family: -apple-system-subheadline, "Didot", "Georgia", "Times New Roman", "Songti SC", "Noto Serif SC", "SimSun", serif;
}

.metric-unit {
  font-size: 34rpx;
  font-weight: 600;
  color: #111111;
  margin-left: 8rpx;
}

/* ===== 特大字号档位（font-xl）适配 ===== */
.font-xl .card-title {
  font-size: 64rpx;
}

.font-xl .welcome-section {
  font-size: 42rpx;
  line-height: 1.85;
}

.font-xl .lead-char {
  font-size: 48rpx;
}

.font-xl .cta-btn {
  height: 128rpx;
}

.font-xl .cta-btn-text {
  font-size: 44rpx;
}

.font-xl .cta-btn-arrow {
  font-size: 48rpx;
}

.font-xl .report-title {
  font-size: 50rpx;
}

.font-xl .metric-label {
  font-size: 34rpx;
}

.font-xl .metric-num {
  font-size: 92rpx;
}

.font-xl .metric-unit {
  font-size: 38rpx;
}
