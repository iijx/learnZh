/* pages/guide/guide.wxss —— 子女引导页（子女阅读，字号 ≥32rpx 即可） */
.page {
  padding: 32rpx 32rpx 60rpx;
}

.page-title {
  font-size: 56rpx;
  font-weight: bold;
  text-align: center;
  margin: 16rpx 0 8rpx;
}

.for-kids {
  font-size: 32rpx;
  color: var(--color-text-light);
  text-align: center;
  margin-bottom: 40rpx;
}

.step {
  display: flex;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  border: 4rpx solid var(--color-line);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.step-num {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 48rpx;
  font-weight: bold;
  color: #FFF8E7;
  background: var(--color-accent);
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.step-body {
  flex: 1;
}

.step-title {
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.step-desc {
  font-size: 34rpx;
  color: var(--color-text-light);
  line-height: 1.6;
}

.tip {
  font-size: 34rpx;
  color: var(--color-text-light);
  text-align: center;
  margin: 16rpx 0 48rpx;
}
