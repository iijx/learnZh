<!-- pages/write/write.wxml —— 写字页：大屏描红，按钮吸底 -->
<view class="write-page">
  <!-- 顶部：当前字（返回用小程序自带导航栏） -->
  <view class="top-bar">
    <view class="char-info">
      <text class="char-text">{{char}}</text>
      <text class="pinyin-text">{{pinyin}}</text>
    </view>
  </view>

  <!-- 大字描红区 -->
  <view class="tracer-wrap">
    <tracer id="tracer" char="{{char}}" size="{{660}}" />
  </view>
  <view class="tip">{{tracing ? (hasStroke ? '跟着金色的点，把字描一遍' : '照着底字，用手指写一写') : '先看一遍笔顺…'}}</view>

  <!-- 底部吸底按钮：重看笔顺 / 擦掉重写 / 写好了 -->
  <view class="bottom-bar">
    <view class="action-row">
      <view wx:if="{{hasStroke}}" class="action-btn secondary" hover-class="btn-hover" bindtap="onReplay">
        <text>重看笔顺</text>
      </view>
      <view class="action-btn secondary" hover-class="btn-hover" bindtap="onClear">
        <text>擦掉重写</text>
      </view>
    </view>
    <view class="action-btn primary finish" hover-class="btn-hover" bindtap="onFinish">
      <text>写好了 ✓</text>
    </view>
  </view>
</view>
