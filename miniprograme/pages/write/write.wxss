/* pages/write/write.wxss —— 写字页 */
.write-page {
  min-height: 100vh;
  background-color: #FAF7F2;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding-bottom: 40rpx;
}

/* 顶栏 */
.top-bar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx 8rpx;
  box-sizing: border-box;
}

.char-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.char-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #111111;
}

.pinyin-text {
  font-size: 36rpx;
  color: #666666;
}

/* 描红区 */
.tracer-wrap {
  margin-top: 24rpx;
}

.tip {
  margin-top: 20rpx;
  font-size: 36rpx;
  color: #666666;
  text-align: center;
}

/* 底部按钮 */
.bottom-bar {
  width: 100%;
  margin-top: auto;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  height: 110rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.action-row .action-btn {
  flex: 1;
}

.action-btn.secondary {
  background-color: #FFFFFF;
  border: 4rpx solid #333333;
  color: #111111;
}

.action-btn.primary.finish {
  width: 100%;
  height: 120rpx;
  background-color: #000000;
  color: #FFFFFF;
  font-size: 42rpx;
}

.btn-hover {
  opacity: 0.75;
}
