/* pages/scene/scene.wxss —— 场景课页 */
.page {
  padding: 24rpx 24rpx 60rpx;
}

.page-title {
  font-size: 60rpx;
  font-weight: bold;
  text-align: center;
  margin: 20rpx 0 8rpx;
}

.page-sub {
  text-align: center;
  margin-bottom: 24rpx;
}

/* 列表项：大卡片，整行可点 */
.scene-item {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 32rpx 40rpx;
  margin: 20rpx 8rpx;
  border: 4rpx solid var(--color-line);
}

.scene-item:active {
  background: var(--color-line);
}

.scene-locked {
  opacity: 0.45;
}

.scene-name {
  font-size: 48rpx;
  font-weight: bold;
}

.scene-passed {
  color: var(--color-accent);
  font-size: 36rpx;
}

.scene-status {
  font-size: 36rpx;
  color: var(--color-text-light);
  margin-top: 8rpx;
}

/* 课内态 */
.scene-img {
  width: 100%;
  height: 360rpx;
  background: var(--color-bg-card);
  border-radius: 24rpx;
}

.hint {
  font-size: 52rpx;
  font-weight: bold;
  text-align: center;
  margin: 32rpx 0;
  color: var(--color-text);
}

/* 目标字卡片：2×2 大字 */
.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

.find-card {
  width: 300rpx;
  height: 300rpx;
  line-height: 300rpx;
  margin: 16rpx;
  text-align: center;
  font-size: 160rpx;
  font-weight: bold;
  background: var(--color-bg-card);
  border: 6rpx solid var(--color-line);
  border-radius: 24rpx;
}

.find-card:active {
  background: var(--color-line);
}

/* 点对：变墨绿 */
.find-card-found {
  background: var(--color-accent);
  border-color: var(--color-accent-deep);
  color: #FFF8E7;
}

.found-progress {
  font-size: 40rpx;
  text-align: center;
  color: var(--color-text-light);
  margin: 24rpx 0 32rpx;
}

/* 过关表扬 */
.praise-char {
  font-size: 160rpx;
  font-weight: bold;
  text-align: center;
  color: var(--color-accent);
  margin: 120rpx 0 32rpx;
}

.praise-sub {
  font-size: 48rpx;
  text-align: center;
  margin-bottom: 80rpx;
}
