<view class="page {{fontClass}}">
  <speaker id="speaker" />

  <!-- 列表态 -->
  <block wx:if="{{view === 'list'}}">
    <view class="page-title">场景课</view>
    <view class="page-sub text-sub">已经认识 {{learnedCount}} 个字啦，点一节课开始找字</view>

    <view wx:for="{{scenes}}" wx:key="id"
          class="scene-item {{item.unlocked ? '' : 'scene-locked'}}"
          data-id="{{item.id}}" bindtap="onTapScene">
      <view class="scene-name">
        第{{item.id}}课 · {{item.title}}
        <text wx:if="{{item.passed}}" class="scene-passed">（已过关）</text>
      </view>
      <view class="scene-status">{{item.unlocked ? '已解锁，点我上课' : '还差 ' + item.need + ' 字解锁'}}</view>
    </view>

    <big-button text="返回" type="plain" bind:tap="goHome" />
  </block>

  <!-- 课内态：占位大图 + 找字卡片 -->
  <block wx:elif="{{view === 'lesson'}}">
    <image class="scene-img" src="{{lesson.image}}" mode="aspectFit" />
    <view class="hint">找一找，你认识的「{{targetChar}}」在哪里</view>

    <view class="cards">
      <view wx:for="{{lesson.cards}}" wx:key="char"
            class="find-card {{item.found ? 'find-card-found' : ''}}"
            data-char="{{item.char}}" bindtap="onTapCard">{{item.char}}</view>
    </view>

    <view class="found-progress">已找到 {{foundCount}} / {{goal}} 个</view>
    <big-button text="返回列表" type="plain" bind:tap="backToList" />
  </block>

  <!-- 过关表扬 -->
  <block wx:else>
    <view class="praise-char">你真棒！</view>
    <view class="praise-sub">这节课的字你全找对啦</view>
    <big-button text="返回列表" bind:tap="backToList" />
  </block>
</view>
