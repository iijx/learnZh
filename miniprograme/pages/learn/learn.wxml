<!-- pages/learn/learn.wxml —— 学习页：新字教学卡片与互动闭环 -->
<view class="learn-page {{fontClass}}">
  <speaker id="speaker" />
  <!-- ================= 0. 课程包加载遮罩（首次启动需联网；失败给大字重试） ================= -->
  <view wx:if="{{packLoading || packError}}" class="pack-mask">
    <block wx:if="{{packLoading}}">
      <view class="pack-mask-icon">📖</view>
      <view class="pack-mask-text">课程加载中，请稍等…</view>
    </block>
    <block wx:else>
      <view class="pack-mask-icon">📡</view>
      <view class="pack-mask-text">课程没加载出来，请检查网络</view>
      <view class="done-action-btn pack-retry-btn" hover-class="btn-hover" bindtap="onRetryPack">
        <text class="done-btn-text">重试</text>
      </view>
    </block>
  </view>
  <!-- ================= 1. TEACH 阶段（新字学习主界面：大字居中，按钮吸底） ================= -->
  <view wx:if="{{stage === 'TEACH'}}" class="teach-wrapper">
    <!-- 顶部进度：五条短横，每学完一个字点亮一格，当前格浅色提示 -->
    <view class="progress-bars">
      <view wx:for="{{[0, 1, 2, 3, 4]}}" wx:key="*this" class="progress-seg {{item < charIndex ? 'seg-done' : (item === charIndex ? 'seg-current' : '')}}"></view>
    </view>
    <scroll-view scroll-y="true" class="scroll-viewer">
      <!-- 1. 一体化字头主卡片：拼音、读音、米字格、写一写快捷入口、复习徽章 -->
      <view class="char-hero-card">
        <!-- 顶部功能行：复习徽章 / 写一写入口 -->
        <view class="hero-top-row">
          <view wx:if="{{isReview}}" class="review-badge-compact">复习 · 连对 {{reviewStreak}} 次</view>
          <view wx:else class="hero-placeholder"></view>
          <view wx:if="{{hasStroke}}" class="mizige-write-btn" hover-class="btn-hover" catchtap="onTapToWrite">
            <text class="mizige-write-text">写一写</text>
          </view>
        </view>
        <!-- 拼音与单字发音行 -->
        <view class="pinyin-row" hover-class="btn-hover" bindtap="onPlayChar">
          <text class="pinyin-text">{{teachCharPinyin}}</text>
          <view wx:if="{{hasCharAudio}}" class="speaker-pill {{playingKey === charKey ? 'playing' : ''}}">
            <image class="speaker-icon" src="/assets/img/icon-speaker-white.svg" mode="aspectFit" />
          </view>
        </view>
        <!-- 精致米字格大字框（360rpx） -->
        <view class="mizige-box" hover-class="mizige-hover" bindtap="onPlayChar">
          <view class="mizige-grid">
            <view class="grid-line line-h"></view>
            <view class="grid-line line-v"></view>
            <view class="grid-line line-d1"></view>
            <view class="grid-line line-d2"></view>
          </view>
          <text class="mizige-char">{{teachChar}}</text>
        </view>
      </view>
      <!-- 2. teachStep 1「看意思」：字义解读 / 组词 / 例句 / 图解插画（紧凑聚合） -->
      <block wx:if="{{teachStep === 1}}">
        <!-- 释义与例句聚合卡片 -->
        <view class="meaning-card">
          <!-- 字义解读 -->
          <view class="meaning-header">
            <view class="section-title-wrap">
              <view class="red-bar"></view>
              <text class="section-title">字义解读</text>
            </view>
            <view wx:if="{{hasExplainAudio}}" class="play-btn-mini {{playingKey === explainKey ? 'playing' : ''}}" hover-class="btn-hover" data-key="{{explainKey}}" data-text="{{explainText}}" bindtap="onPlayAudio">
              <image class="play-icon-mini" src="/assets/img/icon-speaker-white.svg" mode="aspectFit" />
            </view>
          </view>
          <view class="meaning-explain-text">{{explain}}</view>
          <!-- 记字诀 -->
          <!-- <view wx:if="{{mnemonic}}" class="mnemonic-box">
            <text class="mnemonic-tag">记字诀：</text>
            <text class="mnemonic-content">{{mnemonic}}</text>
          </view> -->
          <!-- 分隔线与例句 -->
          <view wx:if="{{sentence}}" class="sentence-wrap">
            <view class="sentence-divider"></view>
            <view class="sentence-header">
              <text class="sentence-label">例句</text>
              <view wx:if="{{hasSentenceAudio}}" class="play-btn-mini {{playingKey === sentenceKey ? 'playing' : ''}}" hover-class="btn-hover" data-key="{{sentenceKey}}" data-text="{{sentence}}" bindtap="onPlayAudio">
                <image class="play-icon-mini" src="/assets/img/icon-speaker-white.svg" mode="aspectFit" />
              </view>
            </view>
            <view class="sentence-text">{{sentence}}</view>
          </view>
        </view>
        <!-- 常用组词：横向 3 联精致词卡 -->
        <view wx:if="{{wordList.length}}" class="words-section">
          <view class="section-header-compact">
            <view class="red-bar-compact"></view>
            <text class="section-title-compact">常用组词</text>
          </view>
          <view class="words-grid">
            <view wx:for="{{wordList}}" wx:key="key" class="word-chip {{playingKey === item.key ? 'playing' : ''}}" hover-class="btn-hover" data-key="{{item.key}}" data-text="{{item.text}}" bindtap="onPlayAudio">
              <text class="word-chip-text">{{item.text}}</text>
              <!-- <image wx:if="{{item.has}}" class="word-chip-speaker" src="/assets/img/icon-speaker-white.svg" mode="aspectFit" /> -->
            </view>
          </view>
        </view>
        <!-- 图解拼音插画板块（紧凑画卷比例） -->
        <view class="ill-section-compact">
          <view class="ill-card-compact">
            <view class="ill-badge-compact">图解拼音</view>
            <image class="ill-image-compact" src="{{imgSrc}}" mode="aspectFit" binderror="onImgError" />
          </view>
        </view>
      </block>
    </scroll-view>
    <!-- 底部固定吸底按钮：每个子步骤主按钮唯一（认一认除外：认识/不认识 左右双选） -->
    <view class="bottom-action-bar">
      <block wx:if="{{teachStep === 0}}">
        <view class="know-hint">认识这个字吗？</view>
        <view class="know-btn-row">
          <view class="know-btn" hover-class="btn-hover" bindtap="onTapUnknown">
            <text class="know-text">不认识</text>
          </view>
          <view class="know-btn" hover-class="btn-hover" bindtap="onTapKnow">
            <text class="know-text">认识</text>
          </view>
        </view>
      </block>
      <block wx:elif="{{teachStep === 1}}">
        <view class="next-step-btn" hover-class="btn-hover" bindtap="onTapLearned">
          <text class="next-text">知道了</text>
        </view>
      </block>
    </view>
  </view>
  <!-- ================= 2. PRACTICE 阶段（学完一组后的互动练习） ================= -->
  <view wx:if="{{stage === 'PRACTICE'}}" class="practice-wrapper">
    <!-- 顶部练习进度条 -->
    <view class="practice-progress-bar">
      <view class="practice-progress-title">
        巩固练习 {{practiceIndex + 1}} / {{practiceTotal}} · {{currentQuestion.title}}
      </view>
      <view class="practice-progress-segs">
        <view wx:for="{{practiceQuestions}}" wx:key="index" class="p-seg {{index < practiceIndex ? 'p-seg-done' : (index === practiceIndex ? 'p-seg-current' : '')}}"></view>
      </view>
    </view>
    <!-- 题目主卡片 -->
    <view class="practice-card">
      <!-- 练习 1：听音选字 -->
      <block wx:if="{{currentQuestion.type === 'LISTEN_SELECT'}}">
        <view class="listen-prompt">
          <view class="listen-speaker-btn {{isCorrect ? 'correct' : ''}}" hover-class="btn-hover" bindtap="onReplayPracticeAudio">
            <image class="listen-speaker-icon" src="/assets/img/icon-speaker-white.svg" mode="aspectFit" />
          </view>
          <text class="listen-hint">点击大喇叭听读音，选出正确的字</text>
        </view>
      </block>
      <!-- 练习 2：例句挖空选字 -->
      <block wx:elif="{{currentQuestion.type === 'SENTENCE_CLOZE'}}">
        <view class="cloze-prompt">
          <view class="cloze-sentence-box" hover-class="btn-hover" bindtap="onReplayPracticeAudio">
            <text class="cloze-text-part">{{currentQuestion.beforeBlank}}</text>
            <view class="cloze-slot {{isCorrect ? 'slot-correct' : (isWrong ? 'slot-wrong' : '')}}">
              <text class="cloze-slot-char">{{isCorrect ? currentQuestion.targetChar : '?'}}</text>
            </view>
            <text class="cloze-text-part">{{currentQuestion.afterBlank}}</text>
            <view class="cloze-speaker-pill">
              <image class="cloze-speaker-icon" src="/assets/img/icon-speaker-white.svg" mode="aspectFit" />
            </view>
          </view>
          <text class="cloze-hint">选出填入括号里最合适的字</text>
        </view>
      </block>
      <!-- 2x2 大字选项网格（四张候选项大卡片） -->
      <view class="option-grid">
        <view wx:for="{{currentQuestion.options}}" wx:key="*this" class="practice-option-btn {{selectedChar === item ? (isCorrect ? 'opt-correct' : (isWrong ? 'opt-wrong' : '')) : ''}}" hover-class="btn-hover" data-char="{{item}}" bindtap="onSelectPracticeOption">
          <text class="option-char">{{item}}</text>
        </view>
      </view>
    </view>
    <!-- 底部状态提示栏 -->
    <view class="practice-feedback-bar">
      <view wx:if="{{isCorrect}}" class="feedback-text feedback-correct">✓ 答对啦！真棒！</view>
      <view wx:elif="{{isWrong}}" class="feedback-text feedback-wrong">✕ 不对哦，再选一次试试</view>
      <view wx:else class="feedback-text feedback-normal">请点击上方卡片选择</view>
    </view>
  </view>
  <!-- ================= 3. DONE 阶段（学完一组表扬） ================= -->
  <view wx:if="{{stage === 'DONE'}}" class="done-wrapper">
    <view class="praise-badge">🏅</view>
    <view class="praise-title">你真棒！</view>
    <view class="praise-desc">这一组新字学完啦，你已经认识 {{learnedCount}} 个字了！</view>
    <view wx:if="{{milestoneTitle}}" class="milestone-card">
      <view class="milestone-badge">🎉 新解锁</view>
      <view class="milestone-name">{{milestoneTitle}}</view>
    </view>
    <view class="done-action-btn" hover-class="btn-hover" bindtap="onDoneBtn">
      <text class="done-btn-text">{{doneBtnText}}</text>
    </view>
    <view class="done-home-btn" hover-class="btn-hover" bindtap="onTapHome">
      <text class="done-home-text">回到首页</text>
    </view>
  </view>
</view>