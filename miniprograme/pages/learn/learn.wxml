<!-- pages/learn/learn.wxml —— 学习页：新字教学卡片与互动闭环 -->
<view class="learn-page {{fontClass}}">
  <speaker id="speaker" />
  <!-- ================= 0. 课程包加载遮罩（首次启动需联网；失败给大字重试） ================= -->
  <view wx:if="{{packLoading || packError}}" class="pack-mask">
    <block wx:if="{{packLoading}}">
      <view class="pack-mask-icon">📖</view>
      <view class="pack-mask-text">课程加载中，请稍等…</view>
    </block>
    <block wx:else>
      <view class="pack-mask-icon">📡</view>
      <view class="pack-mask-text">课程没加载出来，请检查网络</view>
      <view class="done-action-btn pack-retry-btn" hover-class="btn-hover" bindtap="onRetryPack">
        <text class="done-btn-text">重试</text>
      </view>
    </block>
  </view>
  <!-- ================= 1. TEACH 阶段（新字学习主界面：大字居中，按钮吸底） ================= -->
  <view wx:if="{{stage === 'TEACH'}}" class="teach-wrapper">
    <!-- 顶部进度：五条短横，每学完一个字点亮一格，当前格浅色提示 -->
    <view class="progress-bars">
      <view wx:for="{{[0, 1, 2, 3, 4]}}" wx:key="*this" class="progress-seg {{item < charIndex ? 'seg-done' : (item === charIndex ? 'seg-current' : '')}}"></view>
    </view>
    <!-- 「认一认 / 看意思」共用：米字格大字 + 拼音 + 喇叭（点按播单字读音） -->
    <block>
      <view class="mizige-box" hover-class="mizige-hover" bindtap="onPlayChar">
        <view class="mizige-grid">
          <view class="grid-line line-h"></view>
          <view class="grid-line line-v"></view>
          <view class="grid-line line-d1"></view>
          <view class="grid-line line-d2"></view>
        </view>
        <text class="mizige-char">{{teachChar}}</text>
      </view>
      <!-- 拼音与字音播放按钮 -->
      <view class="pinyin-row">
        <text class="pinyin-text">{{teachCharPinyin}}</text>
        <view wx:if="{{hasCharAudio}}" class="speaker-btn {{playingKey === charKey ? 'playing' : ''}}" hover-class="btn-hover" bindtap="onPlayChar">
          <image class="speaker-icon" src="/assets/img/icon-speaker-white.svg" mode="aspectFit" />
        </view>
      </view>
      <!-- 复习字徽章：复习字是之前学过、今天该巩固的字 -->
      <view wx:if="{{isReview}}" class="review-badge">复习 · 已连续认识 {{reviewStreak}} 次</view>
    </block>
    <!-- teachStep 1「看意思」：字义解读 / 组词 / 例句分区展示，每条音频配独立播放按钮 -->
    <block wx:if="{{teachStep === 1}}">
      <!-- 字义解读 -->
      <view class="content-section">
        <view class="section-header">
          <view class="red-bar"></view>
          <text class="section-title">字义解读</text>
        </view>
        <view class="audio-card">
          <text class="audio-card-text">{{explain}}</text>
          <view wx:if="{{hasExplainAudio}}" class="play-btn {{playingKey === explainKey ? 'playing' : ''}}" hover-class="btn-hover"
                data-key="{{explainKey}}" data-text="{{explainText}}" bindtap="onPlayAudio">
            <image class="play-icon" src="/assets/img/icon-speaker-white.svg" mode="aspectFit" />
          </view>
        </view>
        <view wx:if="{{mnemonic}}" class="mnemonic-body">
          <text class="mnemonic-tag">记字诀：</text>
          <text>{{mnemonic}}</text>
        </view>
      </view>
      <!-- 组词（3 条，每条独立播放） -->
      <view wx:if="{{wordList.length}}" class="content-section">
        <view class="section-header">
          <view class="red-bar"></view>
          <text class="section-title">组词</text>
        </view>
        <view wx:for="{{wordList}}" wx:key="key" class="audio-card word-card">
          <text class="audio-card-text word-text">{{item.text}}</text>
          <view wx:if="{{item.has}}" class="play-btn {{playingKey === item.key ? 'playing' : ''}}" hover-class="btn-hover"
                data-key="{{item.key}}" data-text="{{item.text}}" bindtap="onPlayAudio">
            <image class="play-icon" src="/assets/img/icon-speaker-white.svg" mode="aspectFit" />
          </view>
        </view>
      </view>
      <!-- 例句 -->
      <view wx:if="{{sentence}}" class="content-section">
        <view class="section-header">
          <view class="red-bar"></view>
          <text class="section-title">例句</text>
        </view>
        <view class="audio-card">
          <text class="audio-card-text">{{sentence}}</text>
          <view wx:if="{{hasSentenceAudio}}" class="play-btn {{playingKey === sentenceKey ? 'playing' : ''}}" hover-class="btn-hover"
                data-key="{{sentenceKey}}" data-text="{{sentence}}" bindtap="onPlayAudio">
            <image class="play-icon" src="/assets/img/icon-speaker-white.svg" mode="aspectFit" />
          </view>
        </view>
      </view>
      <!-- 图解拼音插画板块 -->
      <view class="ill-section">
        <view class="ill-card">
          <view class="ill-badge">图解拼音</view>
          <image class="ill-image" src="{{imgSrc}}" mode="aspectFit" binderror="onImgError" />
        </view>
      </view>
    </block>
    <!-- 底部固定吸底按钮：每个子步骤主按钮唯一（认一认除外：认识/不认识 左右双选） -->
    <view class="bottom-action-bar">
      <block wx:if="{{teachStep === 0}}">
        <view class="know-hint">认识这个字吗？</view>
        <view class="know-btn-row">
          <view class="know-btn" hover-class="btn-hover" bindtap="onTapUnknown">
            <text class="know-text">不认识</text>
          </view>
          <view class="know-btn" hover-class="btn-hover" bindtap="onTapKnow">
            <text class="know-text">认识</text>
          </view>
        </view>
      </block>
      <block wx:elif="{{teachStep === 1}}">
        <!-- 有笔顺数据：去写字页；无笔顺数据：看完讲解即算学完，直接去下一个字 -->
        <view wx:if="{{hasStroke}}" class="next-step-btn" hover-class="btn-hover" bindtap="onTapToWrite">
          <text class="next-text">写一写</text>
        </view>
        <view wx:else class="next-step-btn" hover-class="btn-hover" bindtap="onTapLearned">
          <text class="next-text">{{isLastChar ? '学完这一组' : '下一个字'}}</text>
        </view>
      </block>
    </view>
  </view>
  <!-- ================= 2. DONE 阶段（学完一组表扬） ================= -->
  <view wx:if="{{stage === 'DONE'}}" class="done-wrapper">
    <view class="praise-badge">🏅</view>
    <view class="praise-title">你真棒！</view>
    <view class="praise-desc">这一组新字学完啦，你已经认识 {{learnedCount}} 个字了！</view>
    <view wx:if="{{milestoneTitle}}" class="milestone-card">
      <view class="milestone-badge">🎉 新解锁</view>
      <view class="milestone-name">{{milestoneTitle}}</view>
    </view>
    <view class="done-action-btn" hover-class="btn-hover" bindtap="onDoneBtn">
      <text class="done-btn-text">{{doneBtnText}}</text>
    </view>
    <view class="done-home-btn" hover-class="btn-hover" bindtap="onTapHome">
      <text class="done-home-text">回到首页</text>
    </view>
  </view>
</view>