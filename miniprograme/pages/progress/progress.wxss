/* pages/progress/progress.wxss —— 我的进度（大字页） */
.page {
  padding: 24rpx 24rpx 60rpx;
}

.stat-label {
  font-size: 44rpx;
  text-align: center;
  color: var(--color-text-light);
  margin-top: 16rpx;
}

/* 已学字数：≥160rpx 超大数字 */
.stat-big {
  font-size: 190rpx;
  font-weight: bold;
  text-align: center;
  color: var(--color-accent);
  line-height: 1.2;
}

.stat-unit {
  font-size: 56rpx;
  margin-left: 12rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0 48rpx;
  gap: 20rpx;
}

.stat-item {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  border: 4rpx solid var(--color-line);
  padding: 24rpx 20rpx;
  text-align: center;
}

.stat-num {
  font-size: 72rpx;
  font-weight: bold;
  text-align: center;
}

.btn-gap {
  height: 36rpx;
}
