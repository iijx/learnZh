/* pages/progress/progress.wxss —— 我的进度（大字页） */
.page {
  padding: 24rpx 24rpx 60rpx;
}

/* 识字果树卡片 */
.tree-card {
  background: var(--color-bg-card);
  border: 4rpx solid var(--color-line);
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(74, 52, 40, 0.06);
}

.tree-icon-wrap {
  width: 140rpx;
  height: 140rpx;
  background: var(--color-gold-bg);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
  border: 4rpx solid var(--color-gold);
}

.tree-icon {
  font-size: 80rpx;
  line-height: 1;
}

.tree-info {
  flex: 1;
}

.tree-level {
  font-size: 46rpx;
  font-weight: bold;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.tree-desc {
  font-size: 34rpx;
  color: var(--color-text-light);
  line-height: 1.4;
}

.stat-label {
  font-size: 44rpx;
  text-align: center;
  color: var(--color-text-light);
  margin-top: 16rpx;
}

/* 已学字数：≥160rpx 超大数字 */
.stat-big {
  font-size: 190rpx;
  font-weight: bold;
  text-align: center;
  color: var(--color-accent);
  line-height: 1.2;
}

.stat-unit {
  font-size: 56rpx;
  margin-left: 12rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0 16rpx;
  gap: 20rpx;
}

.stat-item {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  border: 4rpx solid var(--color-line);
  padding: 24rpx 20rpx;
  text-align: center;
}

.stat-num {
  font-size: 72rpx;
  font-weight: bold;
  text-align: center;
}

.group-title {
  font-size: 50rpx;
  font-weight: bold;
  margin: 44rpx 8rpx 16rpx;
  color: var(--color-text);
}

/* 奖状列表网格 */
.cert-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.cert-item {
  width: 336rpx;
  background: var(--color-bg-card);
  border: 4rpx solid var(--color-line);
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: transform 0.2s ease;
}

.cert-unlocked {
  border-color: var(--color-gold);
  background: var(--color-gold-bg);
  box-shadow: 0 6rpx 16rpx rgba(212, 136, 6, 0.15);
}

.cert-locked {
  opacity: 0.5;
}

.cert-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.cert-name {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.cert-badge {
  font-size: 30rpx;
  color: var(--color-gold);
  font-weight: bold;
}

.cert-locked .cert-badge {
  color: var(--color-text-light);
}

.ms-group-name {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--color-text-light);
  margin: 24rpx 8rpx 8rpx;
}

.ms-item {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  border: 4rpx solid var(--color-line);
  padding: 24rpx 36rpx;
  margin: 12rpx 0;
}

.ms-open:active {
  background: var(--color-line);
}

.ms-locked {
  opacity: 0.45;
}

.ms-title {
  font-size: 42rpx;
  font-weight: bold;
}

.ms-status {
  font-size: 34rpx;
  color: var(--color-text-light);
  margin-top: 4rpx;
}

.ms-status-open {
  color: var(--color-accent);
}

.btn-gap {
  height: 36rpx;
}

/* 奖状大弹窗样式 */
.cert-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.cert-modal {
  width: 100%;
  max-width: 660rpx;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cert-paper {
  position: relative;
  width: 100%;
  background: #FFF8E7;
  border: 12rpx solid #C93B2B;
  border-radius: 28rpx;
  padding: 48rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.35);
}

.cert-seal {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid #C93B2B;
  color: #C93B2B;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-15deg);
}

.cert-top-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #C93B2B;
  text-align: center;
  letter-spacing: 4rpx;
}

.cert-sub-title {
  font-size: 46rpx;
  font-weight: bold;
  color: var(--color-gold);
  text-align: center;
  margin: 16rpx 0 32rpx;
}

.cert-body {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.cert-content {
  font-size: 38rpx;
  line-height: 1.6;
  color: var(--color-text);
  text-indent: 2em;
}

.cert-footer {
  margin-top: 40rpx;
  display: flex;
  justify-content: flex-end;
}

.cert-stamp {
  font-size: 36rpx;
  font-weight: bold;
  color: #C93B2B;
}

.cert-actions {
  margin-top: 36rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.cert-share-btn {
  width: 100% !important;
  min-height: 120rpx;
  line-height: 120rpx;
  background: var(--color-accent);
  color: #FFF;
  font-size: 44rpx;
  font-weight: bold;
  border-radius: 24rpx;
  border: none;
  text-align: center;
}

.cert-close-btn {
  width: 100%;
  min-height: 100rpx;
  line-height: 100rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #FFF;
  font-size: 40rpx;
  text-align: center;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

