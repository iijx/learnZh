<view class="page {{fontClass}}">
  <speaker id="speaker" />

  <!-- 超大字：已学字数 -->
  <view class="stat-label">我已经学过的字</view>
  <view class="stat-big">{{learnedCount}}<text class="stat-unit">个</text></view>

  <view class="stat-row">
    <view class="stat-item">
      <view class="stat-num">{{masteredCount}}</view>
      <view class="stat-label">完全认识</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{learningCount}}</view>
      <view class="stat-label">巩固中</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{streak}}</view>
      <view class="stat-label">连续学习（天）</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{studiedToday ? '已学' : '待学'}}</view>
      <view class="stat-label">今天状态</view>
    </view>
  </view>

  <!-- 阅读课入口：场景 / 古诗 / 故事 -->
  <big-button text="阅读课（场景·古诗·故事）" bind:tap="goReading" />
  <view class="btn-gap"></view>
  <big-button text="返回首页" type="plain" bind:tap="goHome" />
</view>
