# 复制本文件为 .env（.env 已被 gitignore）。所有变量都可选——只覆盖 config.json 的对应字段，CI 用它注入凭证。
#
# LLM 服务（任意 OpenAI 兼容端点；火山方舟时 LLM_MODEL 填推理接入点 ID）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# COS（publish --upload 用；留空则自动回退读 ../audio-pipeline/.env 的 COS_*）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PREFIX=
COS_PUBLIC_BASE_URL=
